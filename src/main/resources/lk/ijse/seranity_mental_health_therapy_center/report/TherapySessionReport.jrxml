<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="TherapySessionReport" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="782" leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30">

    <style name="Title"   forecolor="#1A3A6B" fontSize="18" isBold="true"/>
    <style name="Header"  backcolor="#2E7D55" forecolor="#FFFFFF" fontSize="11" isBold="true"/>
    <style name="Detail"  fontSize="10"/>

    <parameter name="generatedDate" class="java.lang.String"/>

    <queryString language="SQL">
        <![CDATA[
            SELECT ts.id AS session_id, ts.session_date, ts.start_time, ts.end_time,
                   ts.status, COALESCE(ts.notes, '') AS notes,
                   p.name AS patient_name, t.name AS therapist_name, t.specialization
            FROM therapy_session ts
            JOIN patient   p ON ts.patient_id   = p.id
            JOIN therapist t ON ts.therapist_id = t.id
            ORDER BY ts.session_date DESC, ts.start_time ASC
        ]]>
    </queryString>

    <field name="session_id"     class="java.lang.String"/>
    <field name="session_date"   class="java.sql.Date"/>
    <field name="start_time"     class="java.sql.Time"/>
    <field name="end_time"       class="java.sql.Time"/>
    <field name="status"         class="java.lang.String"/>
    <field name="notes"          class="java.lang.String"/>
    <field name="patient_name"   class="java.lang.String"/>
    <field name="therapist_name" class="java.lang.String"/>
    <field name="specialization" class="java.lang.String"/>

    <variable name="totalSessions" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[Boolean.TRUE]]></variableExpression>
    </variable>
    <variable name="completedSessions" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA["COMPLETED".equals($F{status}) ? 1 : 0]]></variableExpression>
    </variable>

    <title>
        <band height="70">
            <rectangle>
                <reportElement x="0" y="0" width="782" height="60" backcolor="#1A3A6B"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="10" y="8" width="500" height="30" forecolor="#FFFFFF"/>
                <textElement><font size="18" isBold="true"/></textElement>
                <text><![CDATA[Seranity Mental Health Therapy Center]]></text>
            </staticText>
            <staticText>
                <reportElement x="10" y="36" width="300" height="18" forecolor="#3DC4A8"/>
                <textElement><font size="12"/></textElement>
                <text><![CDATA[Therapy Session Report]]></text>
            </staticText>
            <textField>
                <reportElement x="560" y="36" width="220" height="16" forecolor="#AACCEE"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA["Generated: " + $P{generatedDate}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="26">
            <rectangle>
                <reportElement x="0" y="0" width="782" height="26" backcolor="#2E7D55"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="5"   y="5" width="75"  height="16" style="Header"/>
                <text><![CDATA[Session ID]]></text>
            </staticText>
            <staticText>
                <reportElement x="85"  y="5" width="85"  height="16" style="Header"/>
                <text><![CDATA[Date]]></text>
            </staticText>
            <staticText>
                <reportElement x="175" y="5" width="60"  height="16" style="Header"/>
                <text><![CDATA[Start]]></text>
            </staticText>
            <staticText>
                <reportElement x="240" y="5" width="60"  height="16" style="Header"/>
                <text><![CDATA[End]]></text>
            </staticText>
            <staticText>
                <reportElement x="305" y="5" width="140" height="16" style="Header"/>
                <text><![CDATA[Patient]]></text>
            </staticText>
            <staticText>
                <reportElement x="450" y="5" width="140" height="16" style="Header"/>
                <text><![CDATA[Therapist]]></text>
            </staticText>
            <staticText>
                <reportElement x="595" y="5" width="90"  height="16" style="Header"/>
                <text><![CDATA[Status]]></text>
            </staticText>
            <staticText>
                <reportElement x="690" y="5" width="87"  height="16" style="Header"/>
                <text><![CDATA[Notes]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="22">
            <textField isBlankWhenNull="true">
                <reportElement x="5"   y="4" width="75"  height="14" style="Detail"/>
                <textFieldExpression><![CDATA[$F{session_id}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="85"  y="4" width="85"  height="14" style="Detail"/>
                <textFieldExpression><![CDATA[$F{session_date}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="175" y="4" width="60"  height="14" style="Detail"/>
                <textFieldExpression><![CDATA[$F{start_time}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="240" y="4" width="60"  height="14" style="Detail"/>
                <textFieldExpression><![CDATA[$F{end_time}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="305" y="4" width="140" height="14" style="Detail"/>
                <textFieldExpression><![CDATA[$F{patient_name}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="450" y="4" width="140" height="14" style="Detail"/>
                <textFieldExpression><![CDATA[$F{therapist_name} + " (" + $F{specialization} + ")"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="595" y="4" width="90" height="14" forecolor="#1A7A4A">
                    <printWhenExpression><![CDATA["COMPLETED".equals($F{status})]]></printWhenExpression>
                </reportElement>
                <textElement><font isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{status}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="595" y="4" width="90" height="14" forecolor="#1A3A6B">
                    <printWhenExpression><![CDATA["SCHEDULED".equals($F{status})]]></printWhenExpression>
                </reportElement>
                <textElement><font isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{status}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="595" y="4" width="90" height="14" forecolor="#CC4400">
                    <printWhenExpression><![CDATA["CANCELLED".equals($F{status})]]></printWhenExpression>
                </reportElement>
                <textElement><font isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{status}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true" textAdjust="StretchHeight">
                <reportElement x="690" y="4" width="87" height="14" style="Detail"/>
                <textFieldExpression><![CDATA[$F{notes}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="22">
            <line>
                <reportElement x="0" y="0" width="782" height="1" forecolor="#2E7D55"/>
            </line>
            <staticText>
                <reportElement x="0" y="5" width="200" height="14" forecolor="#666666"/>
                <textElement><font size="9"/></textElement>
                <text><![CDATA[Seranity Mental Health Therapy Center]]></text>
            </staticText>
            <textField>
                <reportElement x="650" y="5" width="132" height="14" forecolor="#666666"/>
                <textElement textAlignment="Right"><font size="9"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="40">
            <line>
                <reportElement x="0" y="2" width="782" height="1" forecolor="#2E7D55"/>
            </line>
            <staticText>
                <reportElement x="5" y="10" width="200" height="16" forecolor="#333333"/>
                <textElement><font size="11" isBold="true"/></textElement>
                <text><![CDATA[Session Summary:]]></text>
            </staticText>
            <textField>
                <reportElement x="210" y="10" width="400" height="16" forecolor="#333333"/>
                <textElement><font size="10"/></textElement>
                <textFieldExpression><![CDATA["Total: " + $V{totalSessions} + "  |  Completed: " + $V{completedSessions} + "  |  Others: " + ($V{totalSessions} - $V{completedSessions})]]></textFieldExpression>
            </textField>
        </band>
    </summary>

</jasperReport>