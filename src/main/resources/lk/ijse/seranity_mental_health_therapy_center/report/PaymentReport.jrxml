<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="PaymentReport" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="782" leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30">

    <style name="Title" forecolor="#1A3A6B" fontSize="18" isBold="true"/>
    <style name="Header" backcolor="#1A3A6B" forecolor="#FFFFFF" fontSize="11" isBold="true"/>
    <style name="Detail" fontSize="10"/>

    <parameter name="generatedDate" class="java.lang.String"/>

    <queryString language="SQL">
        <![CDATA[
            SELECT py.id AS payment_id, py.payment_date, py.amount, py.status,
                   r.id AS registration_id, p.name AS patient_name, tp.name AS program_name
            FROM payment py
            JOIN registration r     ON py.registration_id = r.id
            JOIN patient p          ON r.patient_id       = p.id
            JOIN therapy_program tp ON r.program_id       = tp.id
            ORDER BY py.payment_date DESC
        ]]>
    </queryString>

    <field name="payment_id"      class="java.lang.String"/>
    <field name="payment_date"    class="java.sql.Date"/>
    <field name="amount"          class="java.lang.Double"/>
    <field name="status"          class="java.lang.String"/>
    <field name="registration_id" class="java.lang.String"/>
    <field name="patient_name"    class="java.lang.String"/>
    <field name="program_name"    class="java.lang.String"/>

    <variable name="totalAmount" class="java.lang.Double" calculation="Sum">
        <variableExpression><![CDATA[$F{amount}]]></variableExpression>
    </variable>
    <variable name="paidAmount" class="java.lang.Double" calculation="Sum">
        <variableExpression><![CDATA["PAID".equals($F{status}) ? $F{amount} : 0.0]]></variableExpression>
    </variable>

    <title>
        <band height="70">
            <rectangle>
                <reportElement x="0" y="0" width="782" height="60" backcolor="#1A3A6B" forecolor="#1A3A6B"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="10" y="8" width="500" height="30" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"><font size="18" isBold="true"/></textElement>
                <text><![CDATA[Seranity Mental Health Therapy Center]]></text>
            </staticText>
            <staticText>
                <reportElement x="10" y="36" width="300" height="18" forecolor="#3DC4A8"/>
                <textElement><font size="12" isBold="true"/></textElement>
                <text><![CDATA[Payment Report]]></text>
            </staticText>
            <textField>
                <reportElement x="560" y="36" width="220" height="16" forecolor="#AACCEE"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA["Generated: " + $P{generatedDate}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="26">
            <rectangle>
                <reportElement x="0" y="0" width="782" height="26" backcolor="#1A3A6B"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="5"   y="5" width="80"  height="16" style="Header"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[Payment ID]]></text>
            </staticText>
            <staticText>
                <reportElement x="90"  y="5" width="90"  height="16" style="Header"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[Date]]></text>
            </staticText>
            <staticText>
                <reportElement x="185" y="5" width="150" height="16" style="Header"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[Patient Name]]></text>
            </staticText>
            <staticText>
                <reportElement x="340" y="5" width="170" height="16" style="Header"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[Program]]></text>
            </staticText>
            <staticText>
                <reportElement x="515" y="5" width="100" height="16" style="Header"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[Registration ID]]></text>
            </staticText>
            <staticText>
                <reportElement x="620" y="5" width="80"  height="16" style="Header"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <text><![CDATA[Amount (Rs.)]]></text>
            </staticText>
            <staticText>
                <reportElement x="705" y="5" width="72"  height="16" style="Header"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[Status]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="22">
            <textField isBlankWhenNull="true">
                <reportElement x="5"   y="4" width="80"  height="14" style="Detail"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{payment_id}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="90"  y="4" width="90"  height="14" style="Detail"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{payment_date}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="185" y="4" width="150" height="14" style="Detail"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{patient_name}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="340" y="4" width="170" height="14" style="Detail"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{program_name}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="515" y="4" width="100" height="14" style="Detail"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{registration_id}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement x="620" y="4" width="80"  height="14" style="Detail"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{amount}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="705" y="4" width="72" height="14" forecolor="#1A7A4A">
                    <printWhenExpression><![CDATA["PAID".equals($F{status})]]></printWhenExpression>
                </reportElement>
                <textElement verticalAlignment="Middle"><font isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{status}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="705" y="4" width="72" height="14" forecolor="#CC4400">
                    <printWhenExpression><![CDATA[!"PAID".equals($F{status})]]></printWhenExpression>
                </reportElement>
                <textElement verticalAlignment="Middle"><font isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{status}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="22">
            <line>
                <reportElement x="0" y="0" width="782" height="1" forecolor="#3DC4A8"/>
            </line>
            <staticText>
                <reportElement x="0" y="5" width="200" height="14" forecolor="#666666"/>
                <textElement verticalAlignment="Middle"><font size="9"/></textElement>
                <text><![CDATA[Seranity Mental Health Therapy Center]]></text>
            </staticText>
            <textField>
                <reportElement x="650" y="5" width="132" height="14" forecolor="#666666"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="50">
            <line>
                <reportElement x="0" y="2" width="782" height="1" forecolor="#1A3A6B"/>
            </line>
            <staticText>
                <reportElement x="450" y="10" width="160" height="16" forecolor="#333333"/>
                <textElement verticalAlignment="Middle"><font size="11" isBold="true"/></textElement>
                <text><![CDATA[Total Collected (PAID):]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement x="620" y="10" width="80" height="16" forecolor="#1A7A4A"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="11" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{paidAmount}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="705" y="10" width="72" height="16" forecolor="#1A7A4A"/>
                <textElement verticalAlignment="Middle"><font size="11" isBold="true"/></textElement>
                <text><![CDATA[ Rs.]]></text>
            </staticText>
            <staticText>
                <reportElement x="450" y="28" width="160" height="16" forecolor="#333333"/>
                <textElement verticalAlignment="Middle"><font size="11" isBold="true"/></textElement>
                <text><![CDATA[Grand Total:]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement x="620" y="28" width="80" height="16" forecolor="#1A3A6B"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="11" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{totalAmount}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="705" y="28" width="72" height="16" forecolor="#1A3A6B"/>
                <textElement verticalAlignment="Middle"><font size="11" isBold="true"/></textElement>
                <text><![CDATA[ Rs.]]></text>
            </staticText>
        </band>
    </summary>

</jasperReport>