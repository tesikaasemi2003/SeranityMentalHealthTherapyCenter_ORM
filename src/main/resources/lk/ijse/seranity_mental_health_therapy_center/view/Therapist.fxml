<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="lk.ijse.seranity_mental_health_therapy_center.controller.TherapistController"
            style="-fx-background-color: #F0F4FF;">

    <VBox spacing="20" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-background-color:white;-fx-padding:16 24;
                     -fx-border-color:#E0E8F8;-fx-border-width:0 0 1 0;">
            <Label fx:id="lblMessage" style="-fx-font-size:13px;-fx-font-weight:bold;"
                   visible="false" managed="false"/>
            <Region HBox.hgrow="ALWAYS"/>

        </HBox>

        <HBox spacing="20" style="-fx-padding:0 24 24 24;" VBox.vgrow="ALWAYS">

            <!-- Form -->
            <VBox spacing="14" prefWidth="300"
                  style="-fx-background-color:white;-fx-padding:24;-fx-background-radius:12;
                         -fx-effect:dropshadow(gaussian,#D0D8F0,8,0,0,2);">
                <Label text="Therapist Details"
                       style="-fx-font-size:14px;-fx-font-weight:bold;-fx-text-fill:#2B3990;
                              -fx-padding:0 0 8 0;-fx-border-color:transparent transparent #E0E8F8 transparent;
                              -fx-border-width:0 0 1 0;"/>

                <VBox spacing="5">
                    <Label text="Therapist ID" style="-fx-font-size:12px;-fx-text-fill:#555;-fx-font-weight:bold;"/>
                    <TextField fx:id="txtId" editable="false"
                               style="-fx-background-radius:6;-fx-border-radius:6;-fx-border-color:#dce3ec;
                                      -fx-padding:8 12;-fx-font-size:13px;-fx-background-color:#f5f7fa;"/>
                </VBox>
                <VBox spacing="5">
                    <Label text="Full Name *" style="-fx-font-size:12px;-fx-text-fill:#555;-fx-font-weight:bold;"/>
                    <TextField fx:id="txtName" promptText="Enter full name"
                               style="-fx-background-radius:6;-fx-border-radius:6;-fx-border-color:#dce3ec;
                                      -fx-padding:8 12;-fx-font-size:13px;"/>
                </VBox>
                <VBox spacing="5">
                    <Label text="Specialization *" style="-fx-font-size:12px;-fx-text-fill:#555;-fx-font-weight:bold;"/>
                    <ComboBox fx:id="cmbSpecialization" promptText="Select specialization"
                              maxWidth="Infinity"
                              style="-fx-background-radius:6;-fx-border-radius:6;
                                     -fx-border-color:#dce3ec;-fx-font-size:13px;"/>
                </VBox>
                <VBox spacing="5">
                    <Label text="Phone *" style="-fx-font-size:12px;-fx-text-fill:#555;-fx-font-weight:bold;"/>
                    <TextField fx:id="txtPhone" promptText="e.g. 0771234567"
                               style="-fx-background-radius:6;-fx-border-radius:6;-fx-border-color:#dce3ec;
                                      -fx-padding:8 12;-fx-font-size:13px;"/>
                </VBox>
                <VBox spacing="5">
                    <Label text="Email *" style="-fx-font-size:12px;-fx-text-fill:#555;-fx-font-weight:bold;"/>
                    <TextField fx:id="txtEmail" promptText="e.g. therapist@email.com"
                               style="-fx-background-radius:6;-fx-border-radius:6;-fx-border-color:#dce3ec;
                                      -fx-padding:8 12;-fx-font-size:13px;"/>
                </VBox>
                <VBox spacing="5">
                    <Label text="Availability" style="-fx-font-size:12px;-fx-text-fill:#555;-fx-font-weight:bold;"/>
                    <ComboBox fx:id="cmbAvailability" promptText="Select availability"
                              maxWidth="Infinity"
                              style="-fx-background-radius:6;-fx-border-radius:6;
                                     -fx-border-color:#dce3ec;-fx-font-size:13px;"/>
                </VBox>
                <HBox spacing="10" style="-fx-padding:8 0 0 0;">
                    <Button text="Clear" onAction="#handleClear"
                            style="-fx-background-color:transparent;-fx-border-color:#2B3990;
                                   -fx-border-radius:6;-fx-background-radius:6;-fx-text-fill:#2B3990;
                                   -fx-padding:8 20;-fx-cursor:hand;"
                            HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button fx:id="btnSave" text="Save" onAction="#handleSave"
                            style="-fx-background-color:#2B3990;-fx-background-radius:6;
                                   -fx-text-fill:white;-fx-padding:8 20;-fx-cursor:hand;"
                            HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                </HBox>
            </VBox>

            <!-- Table -->
            <VBox spacing="12" VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS"
                  style="-fx-background-color:white;-fx-padding:24;-fx-background-radius:12;
                         -fx-effect:dropshadow(gaussian,#D0D8F0,8,0,0,2);">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="Therapist List"
                           style="-fx-font-size:14px;-fx-font-weight:bold;-fx-text-fill:#2B3990;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="txtSearch" promptText="🔍  Search..."
                               prefWidth="200"
                               style="-fx-background-radius:20;-fx-border-radius:20;
                                      -fx-border-color:#dce3ec;-fx-padding:7 14;-fx-font-size:13px;"/>
                </HBox>
                <TableView fx:id="tblTherapist" VBox.vgrow="ALWAYS"
                           style="-fx-background-color:transparent;-fx-border-color:#E0E8F8;-fx-border-radius:8;">
                    <columns>
                        <TableColumn fx:id="colId"             text="ID"             prefWidth="80"/>
                        <TableColumn fx:id="colName"           text="Name"           prefWidth="150"/>
                        <TableColumn fx:id="colSpecialization" text="Specialization" prefWidth="180"/>
                        <TableColumn fx:id="colPhone"          text="Phone"          prefWidth="120"/>
                        <TableColumn fx:id="colEmail"          text="Email"          prefWidth="170"/>
                        <TableColumn fx:id="colAction"         text="Actions"        prefWidth="130"/>
                    </columns>
                </TableView>
            </VBox>
        </HBox>
    </VBox>
</AnchorPane>