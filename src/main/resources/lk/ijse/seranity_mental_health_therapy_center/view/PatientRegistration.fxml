<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="0"
      style="-fx-background-color: #F0F4FF;"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="lk.ijse.seranity_mental_health_therapy_center.controller.PatientRegistrationController">

    <!-- TOP BAR -->
    <HBox alignment="CENTER_LEFT" spacing="12"
          style="-fx-background-color: white; -fx-padding: 16 24;
                 -fx-border-color: #E0E8F8; -fx-border-width: 0 0 1 0;">
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="lblMessage"
               style="-fx-font-size: 13px; -fx-font-weight: bold;"
               visible="false" managed="false" />
    </HBox>

    <!-- SCROLL CONTENT -->
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                style="-fx-background-color: transparent; -fx-background: transparent;"
                VBox.vgrow="ALWAYS">

        <VBox spacing="20" style="-fx-padding: 24;">

            <!-- CARD 1: Personal Information -->
            <VBox spacing="14"
                  style="-fx-background-color: white; -fx-padding: 24; -fx-background-radius: 12;
                         -fx-effect: dropshadow(gaussian, #D0D8F0, 8, 0, 0, 2);">
                <Label text="Personal Information"
                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2B3990;
                              -fx-padding: 0 0 8 0; -fx-border-color: transparent transparent #E0E8F8 transparent;
                              -fx-border-width: 0 0 1 0;" />

                <GridPane hgap="16" vgap="14">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50" />
                        <ColumnConstraints percentWidth="50" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints /><RowConstraints /><RowConstraints />
                    </rowConstraints>

                    <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Full Name *" style="-fx-font-size: 12px; -fx-text-fill: #555; -fx-font-weight: bold;" />
                        <TextField fx:id="txtFullName" prefHeight="38" maxWidth="Infinity"
                                   promptText="Enter full name"
                                   style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #dce3ec;
                                          -fx-padding: 8 12; -fx-font-size: 13px;" />
                    </VBox>

                    <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="NIC Number *" style="-fx-font-size: 12px; -fx-text-fill: #555; -fx-font-weight: bold;" />
                        <TextField fx:id="txtNIC" prefHeight="38" maxWidth="Infinity"
                                   promptText="e.g. 200012345678"
                                   style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #dce3ec;
                                          -fx-padding: 8 12; -fx-font-size: 13px;" />
                    </VBox>

                    <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <Label text="Date of Birth *" style="-fx-font-size: 12px; -fx-text-fill: #555; -fx-font-weight: bold;" />
                        <DatePicker fx:id="dpDOB" maxWidth="Infinity" prefHeight="38"
                                    style="-fx-background-radius: 6; -fx-border-radius: 6;
                                           -fx-border-color: #dce3ec; -fx-font-size: 13px;" />
                    </VBox>

                    <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <Label text="Gender *" style="-fx-font-size: 12px; -fx-text-fill: #555; -fx-font-weight: bold;" />
                        <ComboBox fx:id="cmbGender" maxWidth="Infinity" prefHeight="38"
                                  promptText="Select gender"
                                  style="-fx-background-radius: 6; -fx-border-radius: 6;
                                         -fx-border-color: #dce3ec; -fx-font-size: 13px;" />
                    </VBox>

                    <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="2">
                        <Label text="Blood Group" style="-fx-font-size: 12px; -fx-text-fill: #555; -fx-font-weight: bold;" />
                        <ComboBox fx:id="cmbBloodGroup" maxWidth="Infinity" prefHeight="38"
                                  promptText="Select blood group"
                                  style="-fx-background-radius: 6; -fx-border-radius: 6;
                                         -fx-border-color: #dce3ec; -fx-font-size: 13px;" />
                    </VBox>

                    <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="2">
                        <Label text="Marital Status" style="-fx-font-size: 12px; -fx-text-fill: #555; -fx-font-weight: bold;" />
                        <ComboBox fx:id="cmbMaritalStatus" maxWidth="Infinity" prefHeight="38"
                                  promptText="Select status"
                                  style="-fx-background-radius: 6; -fx-border-radius: 6;
                                         -fx-border-color: #dce3ec; -fx-font-size: 13px;" />
                    </VBox>
                </GridPane>
            </VBox>

            <!-- CARD 2: Contact Information -->
            <VBox spacing="14"
                  style="-fx-background-color: white; -fx-padding: 24; -fx-background-radius: 12;
                         -fx-effect: dropshadow(gaussian, #D0D8F0, 8, 0, 0, 2);">
                <Label text="Contact Information"
                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2B3990;
                              -fx-padding: 0 0 8 0; -fx-border-color: transparent transparent #E0E8F8 transparent;
                              -fx-border-width: 0 0 1 0;" />

                <GridPane hgap="16" vgap="14">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50" />
                        <ColumnConstraints percentWidth="50" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints /><RowConstraints /><RowConstraints />
                    </rowConstraints>

                    <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Phone Number *" style="-fx-font-size: 12px; -fx-text-fill: #555; -fx-font-weight: bold;" />
                        <TextField fx:id="txtPhone" prefHeight="38" maxWidth="Infinity"
                                   promptText="e.g. 0711234567"
                                   style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #dce3ec;
                                          -fx-padding: 8 12; -fx-font-size: 13px;" />
                    </VBox>

                    <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="Email Address" style="-fx-font-size: 12px; -fx-text-fill: #555; -fx-font-weight: bold;" />
                        <TextField fx:id="txtEmail" prefHeight="38" maxWidth="Infinity"
                                   promptText="example@email.com"
                                   style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #dce3ec;
                                          -fx-padding: 8 12; -fx-font-size: 13px;" />
                    </VBox>

                    <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <Label text="Emergency Contact Name" style="-fx-font-size: 12px; -fx-text-fill: #555; -fx-font-weight: bold;" />
                        <TextField fx:id="txtEmergencyName" prefHeight="38" maxWidth="Infinity"
                                   promptText="Guardian / Next of kin"
                                   style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #dce3ec;
                                          -fx-padding: 8 12; -fx-font-size: 13px;" />
                    </VBox>

                    <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <Label text="Emergency Contact Phone" style="-fx-font-size: 12px; -fx-text-fill: #555; -fx-font-weight: bold;" />
                        <TextField fx:id="txtEmergencyPhone" prefHeight="38" maxWidth="Infinity"
                                   promptText="e.g. 0777654321"
                                   style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #dce3ec;
                                          -fx-padding: 8 12; -fx-font-size: 13px;" />
                    </VBox>

                    <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="2">
                        <Label text="Address" style="-fx-font-size: 12px; -fx-text-fill: #555; -fx-font-weight: bold;" />
                        <TextField fx:id="txtAddress" prefHeight="38" maxWidth="Infinity"
                                   promptText="Enter full address"
                                   style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #dce3ec;
                                          -fx-padding: 8 12; -fx-font-size: 13px;" />
                    </VBox>
                </GridPane>
            </VBox>

            <!-- CARD 3: Clinical Information -->
            <VBox spacing="14"
                  style="-fx-background-color: white; -fx-padding: 24; -fx-background-radius: 12;
                         -fx-effect: dropshadow(gaussian, #D0D8F0, 8, 0, 0, 2);">
                <Label text="Clinical Information"
                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2B3990;
                              -fx-padding: 0 0 8 0; -fx-border-color: transparent transparent #E0E8F8 transparent;
                              -fx-border-width: 0 0 1 0;" />

                <GridPane hgap="16" vgap="14">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50" />
                        <ColumnConstraints percentWidth="50" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints /><RowConstraints /><RowConstraints />
                    </rowConstraints>

                    <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Assigned Therapist" style="-fx-font-size: 12px; -fx-text-fill: #555; -fx-font-weight: bold;" />
                        <ComboBox fx:id="cmbTherapist" maxWidth="Infinity" prefHeight="38"
                                  promptText="Select therapist"
                                  style="-fx-background-radius: 6; -fx-border-radius: 6;
                                         -fx-border-color: #dce3ec; -fx-font-size: 13px;" />
                    </VBox>

                    <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="Therapy Type" style="-fx-font-size: 12px; -fx-text-fill: #555; -fx-font-weight: bold;" />
                        <ComboBox fx:id="cmbTherapyType" maxWidth="Infinity" prefHeight="38"
                                  promptText="Select therapy"
                                  style="-fx-background-radius: 6; -fx-border-radius: 6;
                                         -fx-border-color: #dce3ec; -fx-font-size: 13px;" />
                    </VBox>

                    <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <Label text="Registration Date *" style="-fx-font-size: 12px; -fx-text-fill: #555; -fx-font-weight: bold;" />
                        <DatePicker fx:id="dpRegistrationDate" maxWidth="Infinity" prefHeight="38"
                                    style="-fx-background-radius: 6; -fx-border-radius: 6;
                                           -fx-border-color: #dce3ec; -fx-font-size: 13px;" />
                    </VBox>

                    <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <Label text="Status" style="-fx-font-size: 12px; -fx-text-fill: #555; -fx-font-weight: bold;" />
                        <ComboBox fx:id="cmbStatus" maxWidth="Infinity" prefHeight="38"
                                  promptText="Active / Inactive"
                                  style="-fx-background-radius: 6; -fx-border-radius: 6;
                                         -fx-border-color: #dce3ec; -fx-font-size: 13px;" />
                    </VBox>

                    <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="2">
                        <Label text="Medical Notes / Remarks" style="-fx-font-size: 12px; -fx-text-fill: #555; -fx-font-weight: bold;" />
                        <TextArea fx:id="txtMedicalNotes" maxWidth="Infinity" prefHeight="80"
                                  promptText="Enter any notes about the patient's condition or treatment..."
                                  style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #dce3ec;
                                         -fx-padding: 8 12; -fx-font-size: 13px;"
                                  wrapText="true" />
                    </VBox>
                </GridPane>
            </VBox>

            <!-- ACTION BUTTONS -->
            <HBox alignment="CENTER_RIGHT" spacing="10">
                <VBox.margin><Insets bottom="10" /></VBox.margin>
                <Label fx:id="lblError" alignment="CENTER_LEFT"
                       style="-fx-text-fill: #E53935; -fx-font-size: 12px;"
                       text="" HBox.hgrow="ALWAYS" />
                <Button fx:id="btnClear" onAction="#handleClear"
                        prefHeight="38" prefWidth="120"
                        style="-fx-background-color: transparent; -fx-border-color: #2B3990;
                               -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #2B3990;
                               -fx-padding: 8 20; -fx-cursor: hand; -fx-font-size: 13px;"
                        text="Clear" />
                <Button fx:id="btnSave" onAction="#handleSave"
                        prefHeight="38" prefWidth="160"
                        style="-fx-background-color: #2B3990; -fx-background-radius: 6;
                               -fx-text-fill: white; -fx-padding: 8 20; -fx-cursor: hand; -fx-font-size: 13px;"
                        text="Register Patient" />
            </HBox>

            <!-- CARD 4: Registered Patients Table -->
            <VBox spacing="14"
                  style="-fx-background-color: white; -fx-padding: 24; -fx-background-radius: 12;
                         -fx-effect: dropshadow(gaussian, #D0D8F0, 8, 0, 0, 2);">

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="Registered Patients"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2B3990;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <TextField fx:id="txtSearch"
                               prefHeight="36" prefWidth="220"
                               promptText="Search by name or NIC..."
                               style="-fx-background-radius: 20; -fx-border-radius: 20;
                                      -fx-border-color: #dce3ec; -fx-padding: 6 14;
                                      -fx-font-size: 12px;" />
                </HBox>

                <Region prefHeight="1" style="-fx-background-color: #E0E8F8;" />

                <TableView fx:id="tblPatients"
                           prefHeight="320"
                           style="-fx-background-color: transparent; -fx-border-color: transparent;">
                    <columns>
                        <TableColumn fx:id="colId"     text="Patient ID" prefWidth="110" style="-fx-alignment: CENTER;" />
                        <TableColumn fx:id="colName"   text="Full Name"  prefWidth="180" />
                        <TableColumn fx:id="colNIC"    text="NIC"        prefWidth="140" />
                        <TableColumn fx:id="colPhone"  text="Phone"      prefWidth="120" />
                        <TableColumn fx:id="colEmail"  text="Email"      prefWidth="190" />
                        <TableColumn fx:id="colAction" text="Actions"    prefWidth="110"
                                     style="-fx-alignment: CENTER;" sortable="false" />
                    </columns>
                    <placeholder>
                        <Label text="No patients registered yet."
                               style="-fx-text-fill: #aaa; -fx-font-size: 13px;" />
                    </placeholder>
                </TableView>
            </VBox>

        </VBox>
    </ScrollPane>

</VBox>