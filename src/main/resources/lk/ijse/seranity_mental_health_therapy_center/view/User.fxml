<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="lk.ijse.seranity_mental_health_therapy_center.controller.UserController"
            style="-fx-background-color:#F0F4FF;">

    <VBox spacing="20"
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <!-- Top bar -->
        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-background-color:white;-fx-padding:16 24;
                     -fx-border-color:#E0E8F8;-fx-border-width:0 0 1 0;">
            <Label text="User Management"
                   style="-fx-font-size:16px;-fx-font-weight:bold;-fx-text-fill:#2B3990;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblMessage"
                   style="-fx-font-size:13px;-fx-font-weight:bold;"
                   visible="false" managed="false"/>
        </HBox>

        <HBox spacing="20" style="-fx-padding:0 24 24 24;" VBox.vgrow="ALWAYS">

            <!-- ── Form Panel ── -->
            <VBox spacing="12" prefWidth="320"
                  style="-fx-background-color:white;-fx-padding:24;-fx-background-radius:12;
                         -fx-effect:dropshadow(gaussian,#D0D8F0,8,0,0,2);">

                <Label text="User Details"
                       style="-fx-font-size:14px;-fx-font-weight:bold;-fx-text-fill:#2B3990;
                              -fx-padding:0 0 8 0;-fx-border-color:transparent transparent #E0E8F8 transparent;
                              -fx-border-width:0 0 1 0;"/>

                <!-- User ID -->
                <VBox spacing="4">
                    <Label text="User ID"
                           style="-fx-font-size:12px;-fx-text-fill:#555;-fx-font-weight:bold;"/>
                    <TextField fx:id="txtId" editable="false"
                               style="-fx-background-radius:6;-fx-border-radius:6;
                                      -fx-border-color:#dce3ec;-fx-padding:8 12;
                                      -fx-font-size:13px;-fx-background-color:#f5f7fa;"/>
                </VBox>

                <!-- Username -->
                <VBox spacing="4">
                    <Label text="Username *"
                           style="-fx-font-size:12px;-fx-text-fill:#555;-fx-font-weight:bold;"/>
                    <TextField fx:id="txtUsername" promptText="Enter username"
                               style="-fx-background-radius:6;-fx-border-radius:6;
                                      -fx-border-color:#dce3ec;-fx-padding:8 12;-fx-font-size:13px;"/>
                    <Label text="3-30 chars, letters/numbers/._"
                           style="-fx-font-size:10px;-fx-text-fill:#999;"/>
                </VBox>

                <!-- Password + show/hide toggle -->
                <VBox spacing="4">
                    <Label text="Password *"
                           style="-fx-font-size:12px;-fx-text-fill:#555;-fx-font-weight:bold;"/>
                    <HBox spacing="6">
                        <PasswordField fx:id="txtPassword"
                                       promptText="Min 8 chars, A-Z, a-z, 0-9, @#$"
                                       HBox.hgrow="ALWAYS"
                                       style="-fx-background-radius:6;-fx-border-radius:6;
                                              -fx-border-color:#dce3ec;-fx-padding:8 12;-fx-font-size:13px;"/>
                        <TextField fx:id="txtPasswordVisible"
                                   promptText="Min 8 chars, A-Z, a-z, 0-9, @#$"
                                   HBox.hgrow="ALWAYS" visible="false" managed="false"
                                   style="-fx-background-radius:6;-fx-border-radius:6;
                                          -fx-border-color:#dce3ec;-fx-padding:8 12;-fx-font-size:13px;"/>
                        <Button fx:id="btnShowPass" text="👁"
                                onAction="#handleTogglePassword"
                                prefHeight="38" prefWidth="38"
                                style="-fx-background-color:#e8eef8;-fx-background-radius:6;
                                       -fx-border-color:#dce3ec;-fx-border-radius:6;
                                       -fx-padding:6 8;-fx-cursor:hand;-fx-font-size:14px;"/>
                    </HBox>
                </VBox>

                <!-- Confirm Password -->
                <VBox spacing="4">
                    <Label text="Confirm Password *"
                           style="-fx-font-size:12px;-fx-text-fill:#555;-fx-font-weight:bold;"/>
                    <PasswordField fx:id="txtConfirmPassword"
                                   promptText="Re-enter password"
                                   style="-fx-background-radius:6;-fx-border-radius:6;
                                          -fx-border-color:#dce3ec;-fx-padding:8 12;-fx-font-size:13px;"/>
                </VBox>

                <!-- Role -->
                <VBox spacing="4">
                    <Label text="Role *"
                           style="-fx-font-size:12px;-fx-text-fill:#555;-fx-font-weight:bold;"/>
                    <ComboBox fx:id="cmbRole" promptText="Select role" maxWidth="Infinity"
                              style="-fx-background-radius:6;-fx-border-radius:6;
                                     -fx-border-color:#dce3ec;-fx-font-size:13px;"/>
                </VBox>

                <!-- ── Change Password Section (edit mode only) ── -->
                <VBox fx:id="vboxChangePass" spacing="10"
                      visible="false" managed="false"
                      style="-fx-background-color:#f0f4ff;-fx-padding:14;
                             -fx-background-radius:8;-fx-border-color:#c5d3f0;
                             -fx-border-radius:8;-fx-border-width:1;">

                    <Label text="🔒  Change Password"
                           style="-fx-font-size:12px;-fx-font-weight:bold;-fx-text-fill:#2B3990;"/>

                    <!-- New Password -->
                    <VBox spacing="4">
                        <Label text="New Password"
                               style="-fx-font-size:11px;-fx-text-fill:#555;-fx-font-weight:bold;"/>
                        <HBox spacing="6">
                            <PasswordField fx:id="txtNewPassword"
                                           promptText="Leave blank to keep current"
                                           HBox.hgrow="ALWAYS"
                                           style="-fx-background-radius:6;-fx-border-radius:6;
                                                  -fx-border-color:#dce3ec;-fx-padding:8 12;-fx-font-size:12px;"/>
                            <TextField fx:id="txtNewPasswordVisible"
                                       promptText="Leave blank to keep current"
                                       HBox.hgrow="ALWAYS" visible="false" managed="false"
                                       style="-fx-background-radius:6;-fx-border-radius:6;
                                              -fx-border-color:#dce3ec;-fx-padding:8 12;-fx-font-size:12px;"/>
                            <Button fx:id="btnShowNewPass" text="👁"
                                    onAction="#handleToggleNewPassword"
                                    prefHeight="36" prefWidth="36"
                                    style="-fx-background-color:#dce8f8;-fx-background-radius:6;
                                           -fx-border-color:#c5d3f0;-fx-border-radius:6;
                                           -fx-padding:5 7;-fx-cursor:hand;-fx-font-size:13px;"/>
                        </HBox>
                    </VBox>

                    <!-- Confirm New Password -->
                    <VBox spacing="4">
                        <Label text="Confirm New Password"
                               style="-fx-font-size:11px;-fx-text-fill:#555;-fx-font-weight:bold;"/>
                        <PasswordField fx:id="txtConfirmNewPassword"
                                       promptText="Re-enter new password"
                                       style="-fx-background-radius:6;-fx-border-radius:6;
                                              -fx-border-color:#dce3ec;-fx-padding:8 12;-fx-font-size:12px;"/>
                    </VBox>

                    <Label text="Min 8 chars · uppercase · lowercase · digit · special char (@#$%^&amp;+=!)"
                           style="-fx-font-size:10px;-fx-text-fill:#777;-fx-wrap-text:true;"
                           wrapText="true"/>
                </VBox>

                <!-- Action Buttons -->
                <HBox spacing="10" style="-fx-padding:8 0 0 0;">
                    <Button text="Clear" onAction="#handleClear"
                            HBox.hgrow="ALWAYS" maxWidth="Infinity"
                            style="-fx-background-color:transparent;-fx-border-color:#2B3990;
                                   -fx-border-radius:6;-fx-background-radius:6;
                                   -fx-text-fill:#2B3990;-fx-padding:9 20;-fx-cursor:hand;
                                   -fx-font-size:13px;"/>
                    <Button fx:id="btnSave" text="Save" onAction="#handleSave"
                            HBox.hgrow="ALWAYS" maxWidth="Infinity"
                            style="-fx-background-color:#2B3990;-fx-background-radius:6;
                                   -fx-text-fill:white;-fx-padding:9 20;-fx-cursor:hand;
                                   -fx-font-size:13px;-fx-font-weight:bold;"/>
                </HBox>

            </VBox>

            <!-- ── Table Panel ── -->
            <VBox spacing="12" VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS"
                  style="-fx-background-color:white;-fx-padding:24;-fx-background-radius:12;
                         -fx-effect:dropshadow(gaussian,#D0D8F0,8,0,0,2);">

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="User List"
                           style="-fx-font-size:14px;-fx-font-weight:bold;-fx-text-fill:#2B3990;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="txtSearch" promptText="🔍  Search..."
                               prefWidth="200"
                               style="-fx-background-radius:20;-fx-border-radius:20;
                                      -fx-border-color:#dce3ec;-fx-padding:7 14;-fx-font-size:13px;"/>
                </HBox>

                <TableView fx:id="tblUser" VBox.vgrow="ALWAYS"
                           style="-fx-background-color:transparent;
                                  -fx-border-color:#E0E8F8;-fx-border-radius:8;">
                    <columns>
                        <TableColumn fx:id="colId"       text="ID"       prefWidth="80"/>
                        <TableColumn fx:id="colUsername" text="Username" prefWidth="200"/>
                        <TableColumn fx:id="colRole"     text="Role"     prefWidth="160"/>
                        <TableColumn fx:id="colAction"   text="Actions"  prefWidth="160"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>

            </VBox>
        </HBox>
    </VBox>
</AnchorPane>
