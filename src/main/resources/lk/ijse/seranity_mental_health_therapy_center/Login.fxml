<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="lk.ijse.seranity_mental_health_therapy_center.controller.LoginController"
            prefWidth="900" prefHeight="600"
            style="-fx-background-color: #F0F4FF;">

    <VBox AnchorPane.leftAnchor="0" AnchorPane.topAnchor="0"
          AnchorPane.bottomAnchor="0"
          prefWidth="440"
          style="-fx-background-color: #2B3990; -fx-padding: 60 50 60 50;">

        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label text="✦" style="-fx-font-size: 28px; -fx-text-fill: #3DC4A8;"/>
            <Label text="SERENITY" style="-fx-font-size: 22px; -fx-font-weight: BOLD; -fx-text-fill: white;"/>
        </HBox>
        <Label text="Mental Health Therapy Center"
               style="-fx-font-size: 11px; -fx-text-fill: #8899CC;"/>

        <Region VBox.vgrow="ALWAYS"/>

        <VBox spacing="16">
            <Label text="Healing minds,"
                   style="-fx-font-size: 36px; -fx-font-weight: BOLD; -fx-text-fill: white;"/>
            <Label text="changing lives."
                   style="-fx-font-size: 36px; -fx-font-weight: BOLD; -fx-text-fill: #3DC4A8;"/>
            <Label text="Compassionate care for every journey toward mental wellness."
                   wrapText="true"
                   style="-fx-font-size: 13px; -fx-text-fill: #8899CC;"/>
        </VBox>

        <Region VBox.vgrow="ALWAYS"/>

        <HBox spacing="40">
            <VBox spacing="4">
                <Label text="500+" style="-fx-font-size: 20px; -fx-font-weight: BOLD; -fx-text-fill: #3DC4A8;"/>
                <Label text="Patients Helped" style="-fx-font-size: 10px; -fx-text-fill: #8899CC;"/>
            </VBox>
            <VBox spacing="4">
                <Label text="20+" style="-fx-font-size: 20px; -fx-font-weight: BOLD; -fx-text-fill: #2196C8;"/>
                <Label text="Therapists" style="-fx-font-size: 10px; -fx-text-fill: #8899CC;"/>
            </VBox>
            <VBox spacing="4">
                <Label text="98%" style="-fx-font-size: 20px; -fx-font-weight: BOLD; -fx-text-fill: white;"/>
                <Label text="Success Rate" style="-fx-font-size: 10px; -fx-text-fill: #8899CC;"/>
            </VBox>
        </HBox>
    </VBox>

    <VBox AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0"
          AnchorPane.bottomAnchor="0"
          prefWidth="460"
          alignment="CENTER"
          style="-fx-background-color: #F0F4FF; -fx-padding: 60;">

        <VBox spacing="32" maxWidth="340">

            <VBox spacing="8">
                <Label text="Welcome back"
                       style="-fx-font-size: 28px; -fx-font-weight: BOLD; -fx-text-fill: #2B3990;"/>
                <Label text="Sign in to your account to continue"
                       style="-fx-font-size: 13px; -fx-text-fill: #7788AA;"/>
            </VBox>

            <VBox spacing="20">
                <VBox spacing="8">
                    <Label text="Username"
                           style="-fx-font-size: 12px; -fx-font-weight: BOLD; -fx-text-fill: #2B3990;"/>
                    <TextField fx:id="txtUsername" promptText="Enter your username"
                               style="-fx-background-color: white; -fx-border-color: #D0D8F0;
                                      -fx-border-radius: 8; -fx-background-radius: 8;
                                      -fx-padding: 12 16 12 16; -fx-font-size: 13px;"/>
                </VBox>

                <VBox spacing="8">
                    <Label text="Password"
                           style="-fx-font-size: 12px; -fx-font-weight: BOLD; -fx-text-fill: #2B3990;"/>
                    <PasswordField fx:id="txtPassword" promptText="Enter your password"
                                   style="-fx-background-color: white; -fx-border-color: #D0D8F0;
                                          -fx-border-radius: 8; -fx-background-radius: 8;
                                          -fx-padding: 12 16 12 16; -fx-font-size: 13px;"/>
                </VBox>

                <VBox spacing="8">
                    <Label text="Login as"
                           style="-fx-font-size: 12px; -fx-font-weight: BOLD; -fx-text-fill: #2B3990;"/>
                    <ComboBox fx:id="cmbRole" promptText="Select role" maxWidth="Infinity"
                              style="-fx-background-color: white; -fx-border-color: #D0D8F0;
                                     -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 13px;"/>
                </VBox>

                <Label fx:id="lblError" text=""
                       style="-fx-text-fill: #E53935; -fx-font-size: 12px;"/>

                <Button fx:id="btnLogin" text="Sign In" maxWidth="Infinity"
                        onAction="#handleLogin"
                        style="-fx-background-color: #2B3990; -fx-text-fill: white;
                               -fx-font-size: 14px; -fx-font-weight: BOLD;
                               -fx-padding: 14 0 14 0; -fx-background-radius: 8; -fx-cursor: hand;"/>
            </VBox>

            <Label text="© 2025 Serenity Mental Health Therapy Center"
                   style="-fx-font-size: 10px; -fx-text-fill: #AABBCC;" alignment="CENTER"/>
        </VBox>
    </VBox>
</AnchorPane>